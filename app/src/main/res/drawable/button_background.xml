<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Shadow layer with transparency for a smooth shadow effect -->
    <item>
        <shape>
            <solid android:color="#33000000" /> <!-- Semi-transparent shadow -->
            <corners android:radius="12dp" />
        </shape>
    </item>

    <!-- Main button layer with gradient background -->
    <item
        android:left="4dp"
        android:top="4dp"> <!-- Offset to create shadow effect -->
        <shape>
            <gradient
                android:angle="270"
                android:endColor="#7B1FA2"
                android:startColor="#8E24AA" />
            <corners android:radius="12dp" /> <!-- Rounded corners for a modern look -->
            <stroke
                android:width="2dp"
                android:color="#FFFFFF" /> <!-- White border -->
        </shape>
    </item>
</layer-list>
